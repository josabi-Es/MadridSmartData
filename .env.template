# cp .env.template .env -- docker compose lo lee solo desde la raíz del repo.

# Puerto del host para la UI de Airflow.
AIRFLOW_PORT=8081

# Login admin fijo; sin esto `standalone` genera una contraseña aleatoria.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Rango de años para `make ingest-historico`. No aplica a Airflow: el DAG
# daily_ingest usa sus propios params year/month.
INGEST_YEAR_START=2023
INGEST_YEAR_END=2025

# `make train`. Meses a futuro desde el último dato real; máximo 12.
PREDICT_MONTHS=2

# Gases a predecir. Cualquier `magnitud` de gold/fact_calidad_aire vale.
GASES=NO2,O3
