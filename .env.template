# Copy to .env: cp .env.template .env -- docker compose reads .env at the
# repo root automatically, no extra flag needed.

# Host port for the Airflow UI (8080 is often already taken by other local
# containers -- change here if 8081 collides too).
AIRFLOW_PORT=8081

# Fixed Airflow admin login -- without these, `standalone` generates a
# random password each fresh container (see standalone_admin_password.txt
# inside the volume), annoying for a demo you just want to log into.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Año/mes de partida para la ingesta (airflow/dags/daily_ingest.py). Cada
# dataset de bronze usa una granularidad distinta: `aire` y `trafico`
# aceptan solo año (--years 2024), `trafico`/`trafico_puntos_medida`
# necesitan año-mes (--years 2024-01) -- por eso INGEST_MONTH existe
# aparte, no fundido en INGEST_YEAR. Por ahora esto solo fija UN año/mes
# por ejecución del DAG, no un bucle histórico -- automatizar "desde
# INGEST_YEAR hasta hoy" queda pendiente (ver CLAUDE.md, fase 2: "no
# bloquea, se hace cuando haga falta más rango de datos").
INGEST_YEAR=2024
INGEST_MONTH=12
