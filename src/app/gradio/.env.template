# All paths are local Parquet globs read via DuckDB -- no HDFS, no Spark.
# Path to air quality Parquet -> used in first_tab.py, third_tab.py, fourth_tab.py
DATA_AIRQUALITY_PATH=data/processed/aire/*.parquet
# Path to traffic Parquet -> used in second_tab.py, fourth_tab.py
DATA_TRAFFIC_PATH=data/processed/trafico/*.parquet
# Path to district shapefile (bronze, no cleaning needed) -> used in third_tab.py
DISTRITOS_PATH=data/bronze/distritos/latest.parquet
# Path to air stations already joined to their district -> used in third_tab.py, fourth_tab.py
ESTACIONES_DISTRITO_PATH=data/processed/estaciones_aire/latest.parquet
# Path to traffic sensor locations (id -> distrito) -> used in interface.py, fourth_tab.py
TRAFFIC_POINTS_PATH=data/bronze/trafico_puntos_medida/*.parquet
