{
  "datasets": [
    {
      "name": "errores",
      "displayName": "Infra errores",
      "queryLines": [
        "SELECT\n",
        "    CAST(timestamp AS TIMESTAMP)                      AS ts,\n",
        "    CAST(timestamp AS DATE)                           AS fecha,\n",
        "    notebook_name,\n",
        "    error_message,\n",
        "    status,\n",
        "    split_part(notebook_name, '/', 1)                 AS capa,\n",
        "    CASE WHEN status = 'FAILED'  THEN 1 ELSE 0 END    AS es_fallo,\n",
        "    CASE WHEN status = 'SKIPPED' THEN 1 ELSE 0 END    AS es_omitido\n",
        "FROM dev.infra.error_logs\n"
      ]
    },
    {
      "name": "carga",
      "displayName": "Infra ingesta",
      "queryLines": [
        "SELECT\n",
        "    CAST(timestamp AS TIMESTAMP) AS ts,\n",
        "    CAST(timestamp AS DATE)      AS fecha,\n",
        "    notebook_name,\n",
        "    dataset_destino,\n",
        "    partition_key,\n",
        "    rows_written,\n",
        "    status\n",
        "FROM dev.infra.ingestion_log\n"
      ]
    }
  ],
