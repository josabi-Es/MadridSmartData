{
  "datasets": [
    {
      "name": "experimentos_resumen",
      "displayName": "Experimentos resumen",
      "queryLines": [
        "WITH run_agg AS (\n",
        "    SELECT\n",
        "        experiment_id,\n",
        "        COUNT(*)                                            AS n_runs,\n",
        "        SUM(CASE WHEN status = 'FAILED'  THEN 1 ELSE 0 END) AS n_failed,\n",
        "        SUM(CASE WHEN status = 'RUNNING' THEN 1 ELSE 0 END) AS n_running,\n",
        "        MAX(start_time)                                     AS ultimo_run\n",
        "    FROM system.mlflow.runs_latest\n",
        "    GROUP BY experiment_id\n",
        ")\n",
        "SELECT\n",
        "    e.experiment_id,\n",
        "    e.name,\n",
        "    regexp_extract(e.name, '/forecast_experiments/(.*)$', 1) AS experimento,\n",
        "    e.create_time,\n",
        "    e.update_time,\n",
        "    COALESCE(r.n_runs, 0)    AS n_runs,\n",
        "    COALESCE(r.n_failed, 0)  AS n_failed,\n",
        "    COALESCE(r.n_running, 0) AS n_running,\n",
        "    r.ultimo_run,\n",
        "    CASE\n",
        "        WHEN COALESCE(r.n_failed, 0) > 0  THEN 'fallido'\n",
        "        WHEN COALESCE(r.n_runs, 0) = 0    THEN 'vacio_pendiente'\n",
        "        WHEN COALESCE(r.n_running, 0) > 0 THEN 'en_curso'\n",
        "        ELSE 'hecho'\n",
        "    END AS status_bucket\n",
        "FROM system.mlflow.experiments_latest e\n",
        "LEFT JOIN run_agg r ON r.experiment_id = e.experiment_id\n",
        "WHERE e.name LIKE '/Users/formacionjosabi5@gmail.com/forecast_experiments/%'\n",
        "  AND e.delete_time IS NULL\n"
      ]
    },
    {
      "name": "experimento_runs",
      "displayName": "Runs de un experimento",
      "queryLines": [
        "WITH exploded AS (\n",
        "    SELECT\n",
        "        r.run_id,\n",
        "        r.experiment_id,\n",
        "        r.run_name,\n",
        "        r.status,\n",
        "        r.start_time,\n",
        "        r.end_time,\n",
        "        r.params['model_type']    AS model_type,\n",
        "        r.params['max_depth']     AS max_depth,\n",
        "        r.params['max_iter']      AS max_iter,\n",
        "        r.params['n_estimators']  AS n_estimators,\n",
        "        r.params['learning_rate'] AS learning_rate,\n",
        "        r.params['num_leaves']    AS num_leaves,\n",
        "        m.metric_name,\n",
        "        m.latest_value\n",
        "    FROM system.mlflow.runs_latest r\n",
        "    LATERAL VIEW explode(r.aggregated_metrics) t AS m\n",
        ")\n",
        "SELECT\n",
        "    e.name                                                   AS experimento,\n",
        "    regexp_extract(e.name, '/forecast_experiments/(.*)$', 1) AS experimento_nombre,\n",
        "    ex.run_id,\n",
        "    ex.run_name,\n",
        "    ex.status,\n",
        "    ex.start_time,\n",
        "    ex.end_time,\n",
        "    ex.model_type,\n",
        "    ex.max_depth,\n",
        "    ex.max_iter,\n",
        "    ex.n_estimators,\n",
        "    ex.learning_rate,\n",
        "    ex.num_leaves,\n",
        "    MAX(CASE WHEN ex.metric_name = 'mae'   THEN ex.latest_value END) AS mae,\n",
        "    MAX(CASE WHEN ex.metric_name = 'rmse'  THEN ex.latest_value END) AS rmse,\n",
        "    MAX(CASE WHEN ex.metric_name = 'smape' THEN ex.latest_value END) AS smape\n",
        "FROM exploded ex\n",
        "JOIN system.mlflow.experiments_latest e ON e.experiment_id = ex.experiment_id\n",
        "WHERE e.name LIKE '/Users/formacionjosabi5@gmail.com/forecast_experiments/%'\n",
        "GROUP BY e.name, ex.run_id, ex.run_name, ex.status, ex.start_time, ex.end_time,\n",
        "         ex.model_type, ex.max_depth, ex.max_iter, ex.n_estimators, ex.learning_rate, ex.num_leaves\n"
      ]
    },
    {
      "name": "versiones_best",
      "displayName": "Versiones (_best)",
      "queryLines": [
        "SELECT r.run_id\n",
        "FROM system.mlflow.runs_latest r\n",
        "JOIN system.mlflow.experiments_latest e ON e.experiment_id = r.experiment_id\n",
        "WHERE e.name LIKE '/Users/formacionjosabi5@gmail.com/forecast_experiments/%'\n",
        "  AND r.run_name LIKE '%_best'\n"
      ]
    },
    {
      "name": "predicciones_features",
      "displayName": "Predicciones features",
      "queryLines": [
        "SELECT 'no2' AS gas, f.fecha, f.cod_dis, di.nombre AS distrito,\n",
        "       f.valor_medio, f.n_estaciones, f.es_festivo, f.num_fabricas_distrito\n",
        "FROM dev.ml.features_no2 f\n",
        "LEFT JOIN dev.gold.dim_distrito di ON di.cod_dis = lpad(f.cod_dis, 2, '0')\n",
        "UNION ALL\n",
        "SELECT 'pm10' AS gas, f.fecha, f.cod_dis, di.nombre AS distrito,\n",
        "       f.valor_medio, f.n_estaciones, f.es_festivo, f.num_fabricas_distrito\n",
        "FROM dev.ml.features_pm10 f\n",
        "LEFT JOIN dev.gold.dim_distrito di ON di.cod_dis = lpad(f.cod_dis, 2, '0')\n",
        "-- next gas: add another UNION ALL SELECT block here, same columns, table name changed\n"
      ]
    },
    {
      "name": "continuidad",
      "displayName": "Continuidad historico + forecast",
      "queryLines": [
        "WITH hist_raw AS (\n",
        "    SELECT 'no2' AS gas, cod_dis, fecha, valor_medio AS valor,\n",
        "           MAX(fecha) OVER (PARTITION BY cod_dis) AS ultimo_distrito\n",
        "    FROM dev.ml.features_no2\n",
        "    UNION ALL\n",
        "    SELECT 'pm10' AS gas, cod_dis, fecha, valor_medio AS valor,\n",
        "           MAX(fecha) OVER (PARTITION BY cod_dis) AS ultimo_distrito\n",
        "    FROM dev.ml.features_pm10\n",
        "    -- next gas: add another UNION ALL SELECT block here\n",
        "),\n",
        "hist AS (\n",
        "    SELECT gas, cod_dis, fecha, valor, 'historico' AS serie\n",
        "    FROM hist_raw\n",
        "    WHERE fecha >= date_sub(ultimo_distrito, 30)\n",
        "),\n",
        "pred AS (\n",
        "    SELECT 'no2' AS gas, distrito AS cod_dis, fecha, valor_predicho AS valor, 'prediccion' AS serie\n",
        "    FROM dev.ml.forecast_no2_7\n",
        "    UNION ALL\n",
        "    SELECT 'pm10' AS gas, distrito AS cod_dis, fecha, valor_predicho AS valor, 'prediccion' AS serie\n",
        "    FROM dev.ml.forecast_pm10_7\n",
        "    -- next gas: add another UNION ALL SELECT block here\n",
        ")\n",
        "SELECT c.gas, c.cod_dis, di.nombre AS distrito, c.fecha, c.valor, c.serie\n",
        "FROM (SELECT * FROM hist UNION ALL SELECT * FROM pred) c\n",
        "LEFT JOIN dev.gold.dim_distrito di ON di.cod_dis = lpad(c.cod_dis, 2, '0')\n"
      ]
    },
    {
      "name": "predicciones_forecast",
      "displayName": "Predicciones forecast",
      "queryLines": [
        "SELECT 'no2' AS gas, f.distrito AS cod_dis, di.nombre AS distrito_nombre, f.fecha, f.valor_predicho\n",
        "FROM dev.ml.forecast_no2_7 f\n",
        "LEFT JOIN dev.gold.dim_distrito di ON di.cod_dis = lpad(f.distrito, 2, '0')\n",
        "UNION ALL\n",
        "SELECT 'pm10' AS gas, f.distrito AS cod_dis, di.nombre AS distrito_nombre, f.fecha, f.valor_predicho\n",
        "FROM dev.ml.forecast_pm10_7 f\n",
        "LEFT JOIN dev.gold.dim_distrito di ON di.cod_dis = lpad(f.distrito, 2, '0')\n",
        "-- next gas: add another UNION ALL SELECT block here\n"
      ]
    },
    {
      "name": "continuidad_distrito",
      "displayName": "Continuidad modelo distrito",
      "queryLines": [
        "WITH hist_raw AS (\n",
        "    SELECT cod_dis, fecha, valor_medio AS valor,\n",
        "           MAX(fecha) OVER (PARTITION BY cod_dis) AS ultimo_distrito\n",
        "    FROM dev.ml.features_no2_D16_7\n",
        "    -- next gas/distrito: add another UNION ALL SELECT block here\n",
        "),\n",
        "hist AS (\n",
        "    SELECT cod_dis, fecha, valor, 'historico' AS serie\n",
        "    FROM hist_raw\n",
        "    WHERE fecha >= date_sub(ultimo_distrito, 30)\n",
        "),\n",
        "pred AS (\n",
        "    SELECT distrito AS cod_dis, fecha, valor_predicho AS valor, 'prediccion D16' AS serie\n",
        "    FROM dev.ml.forecast_no2_D16_7\n",
        "    -- next gas/distrito: add another UNION ALL SELECT block here\n",
        ")\n",
        "SELECT 'no2' AS gas, c.cod_dis, di.nombre AS distrito, c.fecha, c.valor, c.serie\n",
        "FROM (SELECT * FROM hist UNION ALL SELECT * FROM pred) c\n",
        "LEFT JOIN dev.gold.dim_distrito di ON di.cod_dis = lpad(c.cod_dis, 2, '0')"
      ]
    },
    {
      "name": "forecast_distrito",
      "displayName": "Forecast modelo distrito",
      "queryLines": [
        "SELECT 'no2' AS gas, 'D16' AS modelo, f.distrito AS cod_dis,\n",
        "       di.nombre AS distrito_nombre, f.fecha, f.valor_predicho\n",
        "FROM dev.ml.forecast_no2_D16_7 f\n",
        "LEFT JOIN dev.gold.dim_distrito di ON di.cod_dis = lpad(f.distrito, 2, '0')\n",
        "-- next gas/distrito: add another UNION ALL SELECT block here"
      ]
    },
    {
      "name": "metricas_distrito",
      "displayName": "Metricas por horizonte (distrito)",
      "queryLines": [
        "WITH exploded AS (\n",
        "    SELECT\n",
        "        r.run_id,\n",
        "        r.experiment_id,\n",
        "        r.run_name,\n",
        "        r.status,\n",
        "        r.start_time,\n",
        "        r.params['model_type'] AS model_type,\n",
        "        m.metric_name,\n",
        "        m.latest_value\n",
        "    FROM system.mlflow.runs_latest r\n",
        "    LATERAL VIEW explode(r.aggregated_metrics) t AS m\n",
        ")\n",
        "SELECT\n",
        "    regexp_extract(e.name, '/forecast_experiments/(.*)$', 1) AS experimento,\n",
        "    ex.run_name,\n",
        "    ex.model_type,\n",
        "    ex.status,\n",
        "    ex.start_time,\n",
        "    MAX(CASE WHEN ex.metric_name = 'mae_7d' THEN ex.latest_value END) AS mae_7d,\n",
        "    MAX(CASE WHEN ex.metric_name = 'mae'    THEN ex.latest_value END) AS mae_1paso,\n",
        "    MAX(CASE WHEN ex.metric_name = 'smape'  THEN ex.latest_value END) AS smape,\n",
        "    MAX(CASE WHEN ex.metric_name = 'mae_h1' THEN ex.latest_value END) AS mae_h1,\n",
        "    MAX(CASE WHEN ex.metric_name = 'mae_h2' THEN ex.latest_value END) AS mae_h2,\n",
        "    MAX(CASE WHEN ex.metric_name = 'mae_h3' THEN ex.latest_value END) AS mae_h3,\n",
        "    MAX(CASE WHEN ex.metric_name = 'mae_h4' THEN ex.latest_value END) AS mae_h4,\n",
        "    MAX(CASE WHEN ex.metric_name = 'mae_h5' THEN ex.latest_value END) AS mae_h5,\n",
        "    MAX(CASE WHEN ex.metric_name = 'mae_h6' THEN ex.latest_value END) AS mae_h6,\n",
        "    MAX(CASE WHEN ex.metric_name = 'mae_h7' THEN ex.latest_value END) AS mae_h7\n",
        "FROM exploded ex\n",
        "JOIN system.mlflow.experiments_latest e ON e.experiment_id = ex.experiment_id\n",
        "WHERE e.name LIKE '/Users/formacionjosabi5@gmail.com/forecast_experiments/no2_D%'\n",
        "GROUP BY e.name, ex.run_name, ex.model_type, ex.status, ex.start_time"
      ]
    }
